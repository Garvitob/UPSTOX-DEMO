# ---------- Upstox (account.upstox.com → Developer → My Apps) ----------
UPSTOX_API_KEY=                 # from your Algo Trading app
UPSTOX_API_SECRET=              # from your Algo Trading app
UPSTOX_REDIRECT_URI=https://localhost:3000/callback   # must match the app EXACTLY
UPSTOX_ANALYTICS_TOKEN=         # Analytics tab → Generate Token (1 year, read-only market data)
UPSTOX_ACCESS_TOKEN=            # written by: node scripts/upstox-login.mjs (expires 3:30 AM IST daily)
UPSTOX_SANDBOX_TOKEN=           # Sandbox tab → Generate (30 days). Optional.
UPSTOX_SANDBOX_BASE=https://api-sandbox.upstox.com   # verified 2026-10-04: sandbox.upstox.com does not resolve; official SDK uses api-sandbox

# ---------- Alpaca paper (app.alpaca.markets → Paper Trading → API Keys) ----------
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE=https://paper-api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets
US_SYMBOL=AAPL

# ---------- Feature flags / labels ----------
ENABLE_SANDBOX_ORDER=false      # true = POST test orders to the Upstox sandbox on "Review buy order"
DEMO_ACCOUNT_LABEL=Real holdings (family account)
FX_KEY_OVERRIDE=                # only if you resolved the USD INR global instrument key by hand, e.g. GLOBAL_INDICATOR|USDINR
